++
++// ---------- report ----------
++const count = (n) => 1 + n.children.reduce((s, c) => s + count(c), 0);
++const crossing = (n, part = n.part, acc = new Set()) => { if (n.part) acc.add(n.part); n.children.forEach((c) => crossing(c, part, acc)); return acc; };
