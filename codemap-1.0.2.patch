++
++if (args.mermaid) {
++  const ids = new Map();
++  const pid = (n) => { const label = n.type === 'outside' ? n.name : `${n.part}: ${files.get(n.file)?.name || n.file}`; if (!ids.has(label)) ids.set(label, `p${ids.size}`); return ids.get(label); };
