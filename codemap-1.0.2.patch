++        out.push({ id: e.to, note: `${d === 1 ? 'Directly' : `${d} steps away`}: ${how}` });
++        if (e.to.startsWith('f:')) queue.push(e.to);
++      }
++    }
++    return out;
++  }
++
++  /** A traced flow as a board: its cards in order, with a step-by-step walkthrough. */
++  function traceBoard(start, title) {
