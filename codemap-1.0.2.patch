++}
++if (!roots.length) { console.error(`✗ Nothing on the map matches "${start}". Try a screen URL, "METHOD /path", a file path or file#function.`); process.exit(1); }
++
++// ---------- follow it ----------
++let budget = 400;
++const seen = new Set();
++function fnNode(k, depth, via) {
++  const { p, i, d } = fnAt(k);
