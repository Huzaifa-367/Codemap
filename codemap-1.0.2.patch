++const fnsOf = (p) => files.get(p)?.fn || [];
++const key = (p, i) => `${p}#${i}`;
++const fnAt = (k) => { const [p, i] = [k.slice(0, k.lastIndexOf('#')), +k.slice(k.lastIndexOf('#') + 1)]; return { p, i, d: fnsOf(p)[i] }; };
