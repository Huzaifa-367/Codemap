++  const rt = G.routes.findIndex((r) => (r.name || '').toLowerCase().includes(q) || r.p.toLowerCase().includes(q));
++  let fn = null;
++  for (const f of G.files) { const i = (f.fn || []).findIndex(([n]) => n.toLowerCase().includes(q)); if (i >= 0) { fn = key(f.p, i); break; } }
