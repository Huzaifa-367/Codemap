+#!/usr/bin/env node
+// floorplan trace: follow a flow from where it starts down to the data, function by function, across apps.
+// Starts at a screen, an endpoint, a file or a function; follows calls between functions, the web requests a
+// function makes to the endpoint that answers them (another repo, a mobile app's server…), that endpoint's
+// handler and what it calls in turn, down to the outside services and databases. No tokens: it reads the map.
+//
+// usage: node trace.mjs [root] "<start>" [--depth 8] [--app <part>] [--json | --mermaid | --save "<title>"]
+//   <start>   a screen ("/orders/:id"), an endpoint ("GET /api/orders/:id"), a file ("web/src/Cart.tsx"),
+//             a function ("web/src/api.ts#placeOrder"), or words to search for ("checkout")
+//   --mermaid a sequence diagram of the flow; --json the tree; --save adds it to the map's Flows
+//             (floorplan/custom-flows.json; the next build shows it)
+
+import fs from 'node:fs';
+import path from 'node:path';
+import { parseArgs, mapDir } from './lib/common.mjs';
+
+const args = parseArgs(process.argv.slice(2));
+const root = path.resolve(args._[0] || '.');
+const start = String(args._[1] || '').trim();
+const dir = mapDir(root, { migrate: false });
+const graphFile = path.join(dir, 'graph.json');
+if (!fs.existsSync(graphFile)) { console.error('✗ No floorplan/graph.json here. Make the map first (scan.mjs, then build.mjs).'); process.exit(1); }
+if (!start) { console.error('usage: node trace.mjs <root> "<screen | METHOD /path | file | file#function | words>"'); process.exit(1); }
+const G = JSON.parse(fs.readFileSync(graphFile, 'utf8'));
+const maxDepth = Math.max(1, Math.min(14, Number(args.depth) || 8));
+
+// ---------- indexes ----------
+const files = new Map(G.files.map((f) => [f.p, f]));
+const nodes = new Map(G.nodes.map((n) => [n.id, n]));
+const partOf = (p) => { let n = nodes.get(files.get(p)?.n); while (n?.parent) n = nodes.get(n.parent); return n?.label || 'Unassigned'; };
+const fnsOf = (p) => files.get(p)?.fn || [];
+const key = (p, i) => `${p}#${i}`;
+const fnAt = (k) => { const [p, i] = [k.slice(0, k.lastIndexOf('#')), +k.slice(k.lastIndexOf('#') + 1)]; return { p, i, d: fnsOf(p)[i] }; };
+/** The innermost function of a file covering a line. */
+const fnCovering = (p, line) => { let best = -1; fnsOf(p).forEach(([, a, b], i) => { if (line >= a && line <= b && (best < 0 || a >= fnsOf(p)[best][1])) best = i; }); return best; };
+const callsFrom = new Map();
+for (const [fp, fi, tp, ti, line, loose] of G.calls || []) {
+  const k = key(fp, fi);
+  if (!callsFrom.has(k)) callsFrom.set(k, []);
+  callsFrom.get(k).push({ to: key(tp, ti), line, loose: !!loose });
+}
+// requests: per calling file, [{ line, route }]
+const requestsIn = new Map();
+for (const l of G.links || []) {
+  if (l.k !== 'http' || !l.a.startsWith('f:')) continue;
+  const p = l.a.slice(2);
+  for (const [ri, line] of l.calls || []) if (ri != null && G.routes[ri]) { if (!requestsIn.has(p)) requestsIn.set(p, []); requestsIn.get(p).push({ line, ri }); }
+}
+const outsideOf = (p) => [...new Set((G.links || []).filter((l) => l.a === 'f:' + p && l.b.startsWith('n:') && nodes.get(l.b.slice(2))?.kind === 'external').map((l) => nodes.get(l.b.slice(2)).label))];
