+    `  const order = await placeOrder(req.user, req.body.cartId);`,
+    `  res.json(order);`,
+    `});`,
+    `module.exports = router;`,
+  ].join('\n'),
+  'api/service.js': [
+    `const db = require('./db');`,
+    `async function placeOrder(user, cartId) {`,
+    `  const cart = await loadCart(cartId);`,
+    `  return db.insertOrder(user.id, cart);`,
+    `}`,
+    `function loadCart(id) {`,
